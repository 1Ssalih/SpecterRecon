<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SpecterRecon SOC Raporu — {{ .Target }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0d1117;
      --bg-card: #161b22;
      --bg-card-hover: #21262d;
      --border-color: #30363d;
      --text-main: #c9d1d9;
      --text-muted: #8b949e;
      --cyan-accent: #38bdf8;
      --blue-accent: #6366f1;
      --purple-accent: #a855f7;
      --crit-color: #f43f5e;
      --high-color: #f97316;
      --med-color: #eab308;
      --low-color: #0ea5e9;
      --success-color: #10b981;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-size: 0.875rem;
      line-height: 1.5;
      padding: 1.75rem 1rem;
      min-height: 100vh;
    }
    .container { max-width: 1240px; margin: 0 auto; }
    header {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .header-title h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: #f0f6fc;
      letter-spacing: -0.3px;
    }
    .header-title p { color: var(--text-muted); margin-top: 0.15rem; font-size: 0.8rem; }
    .header-meta {
      display: flex;
      gap: 1.25rem;
      background: #0d1117;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
    }
    .meta-item span { color: var(--cyan-accent); font-weight: 600; }
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.75rem;
    }
    .metric-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.15s ease;
    }
    .metric-card:hover { border-color: #58a6ff; }
    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 3px;
      height: 100%;
      background: var(--cyan-accent);
    }
    .metric-card.critical::before { background: var(--crit-color); }
    .metric-card.high::before { background: var(--high-color); }
    .metric-card.ports::before { background: var(--blue-accent); }
    .metric-card.dirs::before { background: var(--success-color); }
    .metric-card.dns::before { background: var(--purple-accent); }
    .metric-title {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      margin-bottom: 0.3rem;
      font-weight: 600;
    }
    .metric-value {
      font-size: 1.5rem;
      font-weight: 700;
      color: #f0f6fc;
      font-family: 'JetBrains Mono', monospace;
    }
    .section-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.6rem;
    }
    .section-title {
      font-size: 1.05rem;
      font-weight: 600;
      color: #f0f6fc;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .section-badge {
      background: rgba(56, 189, 248, 0.1);
      color: var(--cyan-accent);
      padding: 0.15rem 0.5rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      border: 1px solid rgba(56, 189, 248, 0.2);
    }
    .table-container { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.83rem; }
    th {
      text-align: left;
      padding: 0.6rem 0.8rem;
      background: #0d1117;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.7rem;
      letter-spacing: 0.6px;
      border-bottom: 1px solid var(--border-color);
    }
    td { padding: 0.65rem 0.8rem; border-bottom: 1px solid rgba(48, 54, 61, 0.5); vertical-align: middle; }
    tr:hover td { background: var(--bg-card-hover); }
    .badge {
      display: inline-block;
      padding: 0.15rem 0.45rem;
      border-radius: 5px;
      font-size: 0.7rem;
      font-weight: 600;
      font-family: 'JetBrains Mono', monospace;
      text-transform: uppercase;
    }
    .badge-crit { background: rgba(244, 63, 94, 0.15); color: var(--crit-color); border: 1px solid rgba(244, 63, 94, 0.3); }
    .badge-high { background: rgba(249, 115, 22, 0.15); color: var(--high-color); border: 1px solid rgba(249, 115, 22, 0.3); }
    .badge-med { background: rgba(234, 179, 8, 0.15); color: var(--med-color); border: 1px solid rgba(234, 179, 8, 0.3); }
    .badge-low { background: rgba(14, 165, 233, 0.15); color: var(--low-color); border: 1px solid rgba(14, 165, 233, 0.3); }
    .badge-open { background: rgba(16, 185, 129, 0.15); color: var(--success-color); border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-dns { background: rgba(168, 85, 247, 0.15); color: var(--purple-accent); border: 1px solid rgba(168, 85, 247, 0.3); }
    .code-tag {
      font-family: 'JetBrains Mono', monospace;
      background: #0d1117;
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-size: 0.78rem;
      color: var(--cyan-accent);
      border: 1px solid var(--border-color);
    }
    .vuln-desc { color: #8b949e; font-size: 0.8rem; max-width: 480px; }
    .ref-link {
      color: #58a6ff;
      text-decoration: none;
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .ref-link:hover { text-decoration: underline; }
    footer {
      text-align: center;
      margin-top: 2.5rem;
      color: var(--text-muted);
      font-size: 0.78rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-color);
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-title">
        <h1>SpecterRecon SOC Güvenlik Raporu</h1>
        <p>Otomatik Zafiyet & Keşif Analizi Sonuçları (Go Engine)</p>
      </div>
      <div class="header-meta">
        <div class="meta-item">Hedef: <span>{{ .Target }}</span></div>
        <div class="meta-item">Tarih: <span>{{ .ScanDate }}</span></div>
        <div class="meta-item">Süre: <span>{{ printf "%.2f" .DurationSeconds }}s</span></div>
      </div>
    </header>

    <div class="metric-grid">
      {{ if gt .TotalDNSRecords 0 }}
      <div class="metric-card dns">
        <div class="metric-title">DNS Kayıtları</div>
        <div class="metric-value">{{ .TotalDNSRecords }}</div>
      </div>
      {{ end }}
      <div class="metric-card">
        <div class="metric-title">Keşfedilen Hostlar</div>
        <div class="metric-value">{{ .TotalHosts }}</div>
      </div>
      <div class="metric-card ports">
        <div class="metric-title">Açık Portlar</div>
        <div class="metric-value">{{ .TotalOpenPorts }}</div>
      </div>
      <div class="metric-card critical">
        <div class="metric-title">Tespit Edilen Zafiyetler</div>
        <div class="metric-value">{{ .TotalVulns }}</div>
      </div>
      <div class="metric-card dirs">
        <div class="metric-title">Web Bulguları</div>
        <div class="metric-value">{{ .TotalFindings }}</div>
      </div>
    </div>

    {{ if gt .TotalDNSRecords 0 }}
    <!-- DNS Enumeration & Subdomains -->
    <div class="section-card">
      <div class="section-header">
        <div class="section-title"><span>📡</span> DNS Enumeration & Subdomainler</div>
        <span class="section-badge">{{ len .DNSFindings }} Kayıt</span>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Hostname / Subdomain</th>
              <th>IP Adresi</th>
              <th>Kayıt Tipi</th>
              <th>Kaynak</th>
            </tr>
          </thead>
          <tbody>
            {{ range .DNSFindings }}
            <tr>
              <td><strong>{{ .Hostname }}</strong></td>
              <td><span class="code-tag">{{ .IP }}</span></td>
              <td><span class="badge badge-dns">{{ .RecordType }}</span></td>
              <td>
                {{ if eq .Source "subdomain_bruteforce" }}
                  <span style="color:var(--cyan-accent)">🔍 Subdomain Brute-Force</span>
                {{ else }}
                  <span style="color:var(--text-muted)">Root DNS Çözümleme</span>
                {{ end }}
              </td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>
    {{ end }}

    <!-- Hosts & Services -->
    <div class="section-card">
      <div class="section-header">
        <div class="section-title"><span>🌐</span> Keşfedilen Hostlar & Açık Servisler</div>
        <span class="section-badge">{{ len .Hosts }} Host</span>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>IP & Hostname</th>
              <th>Yöntem</th>
              <th>Açık Port</th>
              <th>Servis Adı</th>
              <th>Versiyon / Başlık</th>
              <th>Banner Detay</th>
            </tr>
          </thead>
          <tbody>
            {{ range .Hosts }}
              {{ $host := .Host }}
              {{ if .Services }}
                {{ range .Services }}
                <tr>
                  <td><strong>{{ $host.IP }}</strong></td>
                  <td><span class="code-tag">{{ $host.DiscoveryMethod }}</span></td>
                  <td><span class="badge badge-open">{{ .Port }}/{{ .Protocol }}</span></td>
                  <td><strong>{{ .ServiceName }}</strong></td>
                  <td>
                    {{ if .ServiceVersion }}
                      <span class="code-tag">{{ .ServiceVersion }}</span>
                    {{ else if .HTTPTitle }}
                      <span style="color:var(--cyan-accent)">{{ .HTTPTitle }}</span>
                    {{ else }}
                      <span style="color:var(--text-muted)">-</span>
                    {{ end }}
                  </td>
                  <td><small style="color:var(--text-muted)">{{ if .BannerRaw }}{{ .BannerRaw }}{{ else }}-{{ end }}</small></td>
                </tr>
                {{ end }}
              {{ else }}
                <tr>
                  <td><strong>{{ $host.IP }}</strong></td>
                  <td><span class="code-tag">{{ $host.DiscoveryMethod }}</span></td>
                  <td colspan="4" style="color:var(--text-muted)">Açık port tespit edilmedi.</td>
                </tr>
              {{ end }}
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Vulnerabilities -->
    <div class="section-card">
      <div class="section-header">
        <div class="section-title"><span>🛡️</span> Tespit Edilen Zafiyetler & CVE'ler</div>
        <span class="section-badge">{{ .TotalVulns }} Zafiyet</span>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>CVE ID</th>
              <th>Şiddet (CVSS)</th>
              <th>Etkilenen Servis</th>
              <th>Açıklama & Risk</th>
              <th>Öneri & Referans</th>
            </tr>
          </thead>
          <tbody>
            {{ $vulnCount := 0 }}
            {{ range .Hosts }}
              {{ range .Vulnerabilities }}
                {{ $vulnCount = 1 }}
                <tr>
                  <td><strong style="color: #f0f6fc; font-family:'JetBrains Mono'">{{ .CVEID }}</strong></td>
                  <td>
                    {{ if eq .Severity "CRITICAL" }}
                      <span class="badge badge-crit">CRITICAL ({{ printf "%.1f" .CVSSScore }})</span>
                    {{ else if eq .Severity "HIGH" }}
                      <span class="badge badge-high">HIGH ({{ printf "%.1f" .CVSSScore }})</span>
                    {{ else if eq .Severity "MEDIUM" }}
                      <span class="badge badge-med">MEDIUM ({{ printf "%.1f" .CVSSScore }})</span>
                    {{ else }}
                      <span class="badge badge-low">{{ .Severity }} ({{ printf "%.1f" .CVSSScore }})</span>
                    {{ end }}
                  </td>
                  <td><span class="code-tag">{{ .AffectedService }}</span></td>
                  <td class="vuln-desc">{{ .Description }}</td>
                  <td>
                    {{ if .Mitigation }}
                      <div style="margin-bottom:0.2rem; font-size:0.78rem; color:var(--success-color)"><strong>Öneri:</strong> {{ .Mitigation }}</div>
                    {{ end }}
                    {{ range .References }}
                      <a href="{{ . }}" target="_blank" class="ref-link">🔗 Referans</a><br>
                    {{ end }}
                  </td>
                </tr>
              {{ end }}
            {{ end }}
            {{ if eq .TotalVulns 0 }}
              <tr>
                <td colspan="5" style="text-align:center; color:var(--success-color); padding: 1.5rem;">
                  ✅ Taranan servislerde bilinen kritik CVE zafiyeti bulunamadı.
                </td>
              </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Web Findings -->
    <div class="section-card">
      <div class="section-header">
        <div class="section-title"><span>📁</span> Web Dizin & Dosya Bulguları (Fuzzer)</div>
        <span class="section-badge">{{ .TotalFindings }} Bulgu</span>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Durum Kodu</th>
              <th>Hedef URL & Yol</th>
              <th>Boyut</th>
              <th>Sayfa Başlığı / Yönlendirme</th>
              <th>Kritiklik / Eşleşme</th>
            </tr>
          </thead>
          <tbody>
            {{ range .Hosts }}
              {{ range .DirFindings }}
                <tr>
                  <td>
                    {{ if eq .StatusCode 200 }}
                      <span class="badge badge-open">200 OK</span>
                    {{ else if or (eq .StatusCode 301) (eq .StatusCode 302) }}
                      <span class="badge badge-high">{{ .StatusCode }} REDIR</span>
                    {{ else }}
                      <span class="badge badge-low">{{ .StatusCode }}</span>
                    {{ end }}
                  </td>
                  <td><a href="{{ .URL }}" target="_blank" class="ref-link">{{ .URL }}</a></td>
                  <td><span class="code-tag">{{ .ContentLength }} B</span></td>
                  <td>
                    {{ if .Title }}
                      <span>{{ .Title }}</span>
                    {{ else if .RedirectLocation }}
                      <span style="color:var(--text-muted)">➜ {{ .RedirectLocation }}</span>
                    {{ else }}
                      <span style="color:var(--text-muted)">-</span>
                    {{ end }}
                  </td>
                  <td>
                    {{ if .IsSensitive }}
                      <span class="badge badge-crit">⚠️ HASSAS DOSYA</span>
                    {{ else if .WordlistMatched }}
                      <span class="badge badge-dns">📁 {{ .WordlistMatched }}</span>
                    {{ else }}
                      <span style="color:var(--text-muted); font-size:0.75rem">Standart</span>
                    {{ end }}
                  </td>
                </tr>
              {{ end }}
            {{ end }}
            {{ if eq .TotalFindings 0 }}
              <tr>
                <td colspan="5" style="text-align:center; color:var(--text-muted); padding: 1.5rem;">
                  Web dizin taraması yapılmadı veya ek bulgu tespit edilmedi.
                </td>
              </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Extended Pentest Module Findings -->
    {{ if .SslFindings }}
    <div class="section-card">
      <div class="section-header">
        <div class="section-title"><span>🔒</span> SSL / TLS Sertifika & Protokol Audit</div>
        <span class="section-badge">{{ len .SslFindings }} Bulgular</span>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr><th>IP & Port</th><th>Sertifika Konusu</th><th>Son Kullanma</th><th>Kalan Gün</th><th>Açıklama & Riskler</th></tr>
          </thead>
          <tbody>
            {{ range .SslFindings }}
            <tr>
              <td><strong>{{ .IP }}:{{ .Port }}</strong></td>
              <td>{{ .Subject }}</td>
              <td><span class="code-tag">{{ .ExpiryDate }}</span></td>
              <td>{{ if .IsExpired }}<span class="badge badge-crit">SÜRESİ DOLMUŞ</span>{{ else }}<span class="badge badge-open">{{ .DaysUntilExpiry }} Gün</span>{{ end }}</td>
              <td>
                {{ range .Notes }}<div style="font-size:0.78rem; color:var(--med-color)">⚠️ {{ . }}</div>{{ end }}
              </td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>
    {{ end }}

    <footer>
      <p>Bu rapor <strong>SpecterRecon SOC Engine (Go)</strong> tarafından otomatik üretilmiştir.</p>
      <p style="margin-top:0.2rem; font-size:0.72rem; color:#484f58">Yalnızca yetkilendirilmiş güvenlik değerlendirme ve lab ortamlarında geçerlidir.</p>
    </footer>
  </div>
</body>
</html>
